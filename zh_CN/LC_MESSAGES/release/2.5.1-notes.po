#: ../../../release/2.5.1-notes.rst:5
msgid "NumPy 2.5.1 Release Notes"
msgstr ""

#: ../../../release/2.5.1-notes.rst:7
msgid ""
"The NumPy 2.5.1 is a patch release that fixes bugs discovered after the "
"2.5.0 release. The most noticeable is the fix is to the numpy datetime "
"cython API which should allow downstream to support NumPy versions older "
"than 2.5. Preparation for Python 3.15 continues along with typing "
"improvements."
msgstr ""

#: ../../../release/2.5.1-notes.rst:12
msgid "This release supports Python versions 3.12-3.14"
msgstr ""

