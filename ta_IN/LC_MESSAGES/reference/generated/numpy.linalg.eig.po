#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/linalg/__init__.py:docstring
#: of numpy.linalg.eig:19
msgid ""
"The eigenvalues, each repeated according to its multiplicity. The "
"eigenvalues are not necessarily ordered. The resulting array will be of "
"complex type. When `a` is real the resulting eigenvalues will be real (0 "
"imaginary part) or occur in conjugate pairs."
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/linalg/__init__.py:docstring
#: of numpy.linalg.eig:25
msgid "**eigenvectors**"
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/linalg/__init__.py:docstring
#: of numpy.linalg.eig:26
msgid ""
"The normalized (unit \"length\") eigenvectors, such that the column "
"``eigenvectors[:,i]`` is the eigenvector corresponding to the eigenvalue "
"``eigenvalues[i]``."
msgstr ""

