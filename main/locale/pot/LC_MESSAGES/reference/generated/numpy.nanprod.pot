msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/__init__.py:docstring
#: of numpy.nanprod:38
msgid ""
"The starting value for this product. See `~numpy.ufunc.reduce` for details."
msgstr ""

