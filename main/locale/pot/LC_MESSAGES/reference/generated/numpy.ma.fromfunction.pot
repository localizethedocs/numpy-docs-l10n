#: ../../../reference/generated/numpy.ma.fromfunction.rst:4
msgid "numpy.ma.fromfunction"
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/ma/core.py:docstring
#: of numpy.ma.core.fromfunction:2
msgid "Construct an array by executing a function over each coordinate."
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/ma/core.py:docstring
#: of numpy.ma.core.fromfunction:4
msgid ""
"The function is called once with one coordinate array for each dimension of "
"`shape` instead of once per coordinate."
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/ma/core.py:docstring
#: of numpy.ma.core.fromfunction:7
msgid ""
"For functions that operate elementwise on array arguments, the resulting "
"array has a value ``fn(x, y, z)`` at coordinate ``(x, y, z)``."
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/ma/core.py:docstring
#: of numpy.ma.core.fromfunction:0
msgid "Parameters"
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/ma/core.py:docstring
#: of numpy.ma.core.fromfunction:12
msgid "**function**"
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/ma/core.py:docstring
#: of numpy.ma.core.fromfunction:-1
msgid "callable"
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/ma/core.py:docstring
#: of numpy.ma.core.fromfunction:13
msgid ""
"The function is called once with N coordinate arrays as parameters, where N "
"is the length of `shape`. Each array represents the coordinates along a "
"specific axis.  For example, if `shape` were ``(2, 2)``, then the parameters "
"would be ``array([[0, 0], [1, 1]])`` and ``array([[0, 1], [0, 1]])``"
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/ma/core.py:docstring
#: of numpy.ma.core.fromfunction:19
msgid "**shape**"
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/ma/core.py:docstring
#: of numpy.ma.core.fromfunction:-1
msgid "(N,) tuple of ints"
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/ma/core.py:docstring
#: of numpy.ma.core.fromfunction:20
msgid ""
"Shape of the coordinate arrays passed to `function`. The shape of the output "
"is determined by the value returned by `function` and may be different from "
"`shape`"
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/ma/core.py:docstring
#: of numpy.ma.core.fromfunction:24
msgid "**dtype**"
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/ma/core.py:docstring
#: of numpy.ma.core.fromfunction:-1
msgid "data-type, optional"
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/ma/core.py:docstring
#: of numpy.ma.core.fromfunction:25
msgid ""
"Data-type of the coordinate arrays passed to `function`. By default, `dtype` "
"is float."
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/ma/core.py:docstring
#: of numpy.ma.core.fromfunction:28
msgid "**like**"
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/ma/core.py:docstring
#: of numpy.ma.core.fromfunction:-1
msgid "array_like, optional"
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/ma/core.py:docstring
#: of numpy.ma.core.fromfunction:29
msgid ""
"Reference object to allow the creation of arrays which are not NumPy arrays. "
"If an array-like passed in as ``like`` supports the ``__array_function__`` "
"protocol, the result will be defined by it. In this case, it ensures the "
"creation of an array object compatible with that passed in via this argument."
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/ma/core.py:docstring
#: of numpy.ma.core.fromfunction:0
msgid "Returns"
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/ma/core.py:docstring
#: of numpy.ma.core.fromfunction:41
msgid "fromfunction: MaskedArray"
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/ma/core.py:docstring
#: of numpy.ma.core.fromfunction:42
msgid ""
"The result of the call to `function` is passed back directly. Therefore the "
"shape of `fromfunction` is completely determined by `function`.  If "
"`function` returns a scalar value, the shape of `fromfunction` would not "
"match the `shape` parameter."
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/ma/core.py:docstring
#: of numpy.ma.core.fromfunction:56
msgid ":obj:`indices`, :obj:`meshgrid`"
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/ma/core.py:docstring
#: of numpy.ma.core.fromfunction:60
msgid "Notes"
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/ma/core.py:docstring
#: of numpy.ma.core.fromfunction:61
msgid "Keywords other than `dtype` and `like` are passed to `function`."
msgstr ""

#: ../../../../../../../.conda/lib/python3.13/site-packages/numpy/ma/core.py:docstring
#: of numpy.ma.core.fromfunction:64
msgid ""
"`shape` determines the shape of the coordinate arrays passed to `function`. "
"It does not enforce that the function returns a result with that shape. If "
"`function` returns a scalar, the result is a scalar rather than an array "
"with the given `shape`."
msgstr ""

