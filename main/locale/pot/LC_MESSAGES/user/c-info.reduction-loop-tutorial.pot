"np_dep = dependency('numpy')\n"
"\n"
"sources = files('minmax.c')\n"
"\n"
"extension_module = py.extension_module(\n"
"  'minmax',\n"
"  sources,\n"
"  dependencies: [np_dep],\n"
"  install: true,\n"
")"
msgstr ""

#: ../../../user/c-info.reduction-loop-tutorial.rst:0
msgid "setuptools"
msgstr ""

