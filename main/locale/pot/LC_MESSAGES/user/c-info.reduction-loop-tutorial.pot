"[project]\n"
"name = \"minmax\"\n"
"dependencies = [\"numpy\"]\n"
"version = \"0.1\"\n"
"\n"
"[build-system]\n"
"requires = [\"setuptools\", \"numpy\"]\n"
"build-backend = \"setuptools.build_meta\""
msgstr ""

