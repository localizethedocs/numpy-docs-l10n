#: ../../../release/2.5.5-notes.rst:5
msgid "NumPy 2.5.5 Release Notes"
msgstr ""

#: ../../../release/2.5.5-notes.rst:7
msgid "*Released on 2026-11-15.*"
msgstr ""

#: ../../../release/2.5.5-notes.rst:9
msgid ""
"NumPy 2.5.5 is a patch release that fixes bugs discovered after the 2.5.4 "
"release. It is unusually large for a patch release due to bugs discovered "
"during continuing work on strings for the upcoming 2.6.0 release, ongoing "
"threading work, the eMudhra compromise fixes, and updates in GitHub CI "
"infrastructure."
msgstr ""

#: ../../../release/2.5.5-notes.rst:15
msgid "This release supports Python versions 3.12-3.15."
msgstr ""

#: ../../../release/2.5.5-notes.rst:19
msgid "Compatibility notes"
msgstr ""

#: ../../../release/2.5.5-notes.rst:21
msgid ""
"Casting a structured void dtype or subarray dtype to "
"`numpy.dtypes.StringDType` now raises a ``TypeError`` instead of "
"interpreting the raw bytes of each element as UTF-8."
msgstr ""

